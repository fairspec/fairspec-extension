{
  "name": "@fairspec-extension/root",
  "version": "0.4.0",
  "private": true,
  "description": "Fairspec extension template",
  "homepage": "https://fairspec.github.io/fairspec-extension",
  "author": "Evgeny Karev",
  "repository": "https://github.com/datisthq/fairspec-extension",
  "type": "module",
  "scripts": {
    "build:py": "uv --directory python build",
    "build:ts": "pnpm -F fairspec-* build",
    "configure": "node @configure.ts",
    "deps": "ncu -ws -u --cooldown 7d",
    "generate": "node @generate.ts",
    "format": "vp fmt --no-error-on-unmatched-pattern",
    "leaks": "gitleaks git --config=.gitleaks.toml --verbose --redact",
    "lint": "vp fmt --check && vp lint",
    "prepare": "lefthook install",
    "release:py": "uv --directory python publish",
    "release:ts": "pnpm -r publish --access public --ignore-scripts --no-git-checks",
    "scan": "pnpm leaks && pnpm vulns",
    "start": "livemark start",
    "docs:start": "livemark start",
    "docs:build": "livemark build",
    "test": "pnpm lint && pnpm type",
    "type": "pnpm -r type",
    "vers:py": "uv --directory python version",
    "vers:ts": "pnpm version --recursive --no-git-checks",
    "vulns": "semgrep --config=p/typescript --config=p/nodejs --config=p/owasp-top-ten --config=p/secrets --metrics=off"
  },
  "devDependencies": {
    "@clack/prompts": "0.11.0",
    "@plausible-analytics/tracker": "0.4.4",
    "@semantic-release/exec": "7.1.0",
    "@tanstack/react-router": "1.168.1",
    "@tanstack/react-start": "1.167.2",
    "@types/node": "24.5.2",
    "@typescript/native-preview": "7.0.0-dev.20260316.1",
    "cn": "0.2.4",
    "conventional-changelog-conventionalcommits": "9.1.0",
    "execa": "9.6.0",
    "fairspec": "0.12.4",
    "json-schema-to-typescript": "15.0.4",
    "lefthook": "2.1.1",
    "livemark": "0.18.0",
    "lucide-react": "0.577.0",
    "npm-check-updates": "23.1.0",
    "quicktype": "23.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remark": "15.0.1",
    "replace-in-file": "8.3.0",
    "semantic-release": "24.2.9",
    "smol-toml": "1.4.2",
    "tasuku": "2.0.5",
    "ts-to-zod": "5.1.0",
    "vite-plus": "0.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "engines": {
    "node": "^24.0.0",
    "pnpm": "^11.0.0"
  },
  "packageManager": "pnpm@11.26.0+sha512.fc0e2bf890b9f983611f1ab68c0637bce914390653699f83c1a78b005ed25f2c81e77920c8fd8eee2ecf0b58b28cdcb00a84d97f69bcf7c56b2f344710238664",
  "slug": "fairspec-extension",
  "title": "Fairspec Extension"
}
